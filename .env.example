# ==============================================================================
# KAVACH Wildlife Intelligence — Environment Configuration Template
# ==============================================================================

# GIS & Satellite Map Provider
# Options: "esri" (default, high-res satellite imagery, no API key required)
#          "mapbox" (requires VITE_MAPBOX_ACCESS_TOKEN)
#          "google" (requires VITE_GOOGLE_MAPS_API_KEY)
VITE_MAP_PROVIDER=esri

# Optional: Mapbox Satellite Token (Leave blank to use legal Esri World Imagery)
# Note: Public browser tokens should have URL/domain restrictions in production
VITE_MAPBOX_ACCESS_TOKEN=

# Optional: Google Maps API Key (Leave blank to use legal Esri World Imagery)
# Note: Public browser API keys should have HTTP referer restrictions in production
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Endpoint
VITE_API_BASE_URL=http://localhost:8000
